# ---------------------------------------------------------------------------
# ToDo — copy to .env and fill in.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) --------------------------------------------------
# DATABASE_URL is the pooled connection used at runtime. On Vercel + Neon this
# is the "-pooler" host — serverless opens many short-lived connections and
# will exhaust a direct Postgres otherwise.
# DIRECT_URL is the unpooled connection, used only by `prisma migrate`.
# Locally, `docker compose up -d db` gives you both at the same address.
#
# On a host that injects its own names you can leave both unset: the build
# falls back to DATABASE_URL_UNPOOLED (Neon) and POSTGRES_PRISMA_URL /
# POSTGRES_URL_NON_POOLING (Vercel Postgres).
DATABASE_URL="postgresql://todo:todo@localhost:5432/todo"
DIRECT_URL="postgresql://todo:todo@localhost:5432/todo"

# Throwaway database for `npm test`. Its contents are wiped on every run.
TEST_DATABASE_URL="postgresql://todo:todo@localhost:5432/todo_test"

# Where the app is reachable. Used for links inside notifications.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Web push (optional but recommended) -----------------------------------
# Generate a pair with:  npm run gen:vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# --- Scheduled housekeeping -------------------------------------------------
# Protects /api/cron/tick. Any long random string.
CRON_SECRET=""

# --- Access -----------------------------------------------------------------
# Registration closes after the first account. Set to "true" to keep it open.
ALLOW_SIGNUPS="false"

# --- Seed (npm run db:seed) -------------------------------------------------
SEED_EMAIL="you@example.com"
SEED_PASSWORD="todo1234"
SEED_NAME="Jamie"
SEED_TIMEZONE="America/New_York"
