# ---------------------------------------------------------------------------
# ToDo — copy to .env and fill in.
# ---------------------------------------------------------------------------

# Database. SQLite by default: no server, and the file lives next to the app.
# SQLite paths are resolved relative to prisma/, so "../data" means <repo>/data.
# For Postgres, change `provider` in prisma/schema.prisma to "postgresql" and
# point this at your connection string.
DATABASE_URL="file:../data/todo.db"

# Where the app is reachable. Used for links inside notifications.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Web push (optional but recommended) -----------------------------------
# Generate a pair with:  npm run gen:vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# --- Scheduled housekeeping -------------------------------------------------
# Protects /api/cron/tick. Any long random string.
CRON_SECRET=""

# --- Access -----------------------------------------------------------------
# Registration closes after the first account. Set to "true" to keep it open.
ALLOW_SIGNUPS="false"

# --- Seed (npm run db:seed) -------------------------------------------------
SEED_EMAIL="you@example.com"
SEED_PASSWORD="todo1234"
SEED_NAME="Jamie"
SEED_TIMEZONE="America/New_York"
